{
  // Typecheck-only config: bun executes the .ts directly, so tsc never emits --
  // settings mirror how bun actually runs this code (ESM, .ts-extension
  // imports, bundler-style resolution, Bun globals).
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["lib", "tests", "evals/lib"]
}
